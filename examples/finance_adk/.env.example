# AgentArts Finance Agent Demo - Environment Variables
# Copy this file to .env and fill in your values.

# --- AgentArts Memory SDK Endpoints ---
AGENTARTS_CONTROL_ENDPOINT=https://agentarts.cn-southwest-2.myhuaweicloud.com
AGENTARTS_MEMORY_DATA_ENDPOINT=

# --- SSL Verification ---
VERIFY_SSL=true

# --- AgentArts Memory SDK ---
# Run setup_memory.py first, then paste the printed values here.
AGENTARTS_MEMORY_SPACE_ID=
HUAWEICLOUD_SDK_MEMORY_API_KEY=

# --- Code Interpreter ---
# Run setup_code_interpreter.py first, then values are auto-written here.
AGENTARTS_CODEINTERPRETER_DATA_ENDPOINT=
CODE_INTERPRETER_REGION=cn-southwest-2
CODE_INTERPRETER_NAME=
HUAWEICLOUD_SDK_CODE_INTERPRETER_API_KEY=

# --- LLM Configuration (ADK uses LiteLLM provider/model format) ---
# Model name with provider prefix, e.g. "openai/deepseek-v4-flash"
LLM_MODEL_NAME=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=