{
  "name": "agentarts-memory-mcp",
  "version": "1.0.0",
  "description": "AgentArts Memory MCP server (TypeScript, zero runtime deps) \u2014 a read-only recall tool (search_memories) over the Huawei Cloud AgentArts Memory data-plane REST API. Single-file bundled dist/index.mjs, runs with Node >= 18 only.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "agentarts-memory-mcp": "dist/index.mjs"
  },
  "main": "dist/index.mjs",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/mcp-server.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  }
}